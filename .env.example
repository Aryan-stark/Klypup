# ─── MongoDB ───────────────────────────────────────────────
MONGODB_URL=mongodb://mongo:27017
MONGODB_DB_NAME=klypup_pricing

# ─── AI Provider (set ONE of the two keys below) ───────────
# Option A: Google Gemini — free tier 1500 req/day
#   Get key: https://aistudio.google.com → "Get API key"
GEMINI_API_KEY=your-gemini-api-key-here

# Option B: Groq — free tier 100k tokens/day
#   Get key: https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# If GEMINI_API_KEY is set, it takes priority over GROQ_API_KEY.

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── App ────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173

# ─── Frontend ───────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1
