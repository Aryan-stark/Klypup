# ─── MongoDB ───────────────────────────────────────────────
MONGODB_URL=mongodb://mongo:27017
MONGODB_DB_NAME=klypup_pricing

# ─── AI Provider ───────────────────────────────────────────
# Set ONE or more. Priority order: Cerebras → Gemini → Groq
# The first key that is set (non-empty) is used as the fallback provider.
# Admins can also override the provider per-org in Settings → AI Configuration.

# Option A: Cerebras — fastest free tier (recommended)
#   Get key: https://cloud.cerebras.ai
CEREBRAS_API_KEY=your-cerebras-api-key-here

# Option B: Google Gemini — free tier 1500 req/day
#   Get key: https://aistudio.google.com → "Get API key"
GEMINI_API_KEY=your-gemini-api-key-here

# Option C: Groq — free tier 100k tokens/day
#   Get key: https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── App ────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173

# ─── Frontend ───────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1
